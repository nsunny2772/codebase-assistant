# Copy to backend/.env. Never put provider credentials in frontend variables.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-code-4
VOYAGE_EMBEDDING_DIMENSIONS=1024
# Answers use Groq; embeddings use Voyage.
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Configure the answer model with GROQ_ANSWER_MODEL.

NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required before answers can be generated. Choose a model available to your API project.
# Set to a verified context capacity for that model; this is an internal ceiling.
MODEL_CONTEXT_TOKENS=32000
MAX_OUTPUT_TOKENS=4000
# Lower for a provider account with small per-minute token limits.
MAX_EVIDENCE_BYTES=14000

PUBLIC_ORIGIN=http://127.0.0.1:5173
MAX_SOURCE_FILES=1000
MAX_REPOSITORY_BYTES=52428800
MAX_ACTIVE_JOBS=3
# Conservative headroom below AuraDB Free graph quotas. Raise for larger deployments.
GRAPH_NODE_LIMIT=180000
GRAPH_RELATIONSHIP_LIMIT=360000
# Operational readiness and safe retention policy.
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_STALE_MS=45000
INACTIVE_SNAPSHOT_RETENTION_DAYS=30
SNAPSHOT_CLEANUP_INTERVAL_MS=3600000
# Retry only transient indexing failures, up to three total attempts.
INDEX_RETRY_BASE_DELAY_MS=2000
INDEX_RETRY_MAX_DELAY_MS=30000
INDEX_MAX_ATTEMPTS=3
MAX_EMBEDDING_TOKENS_PER_JOB=200000
# Token reservations use UTC days and remain charged on uncertain provider failures.
DAILY_EMBEDDING_TOKEN_LIMIT=1000000
DAILY_ANSWER_TOKEN_LIMIT=200000
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_ANSWER_MODEL=qwen/qwen3.8-27b

# Tune these to the Voyage rate limits shown for your account.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BATCH_DELAY_MS=0
